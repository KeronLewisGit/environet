APP_NAME="Environet, Inc."
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.environetinc.com
APP_TIMEZONE=Pacific/Honolulu
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_enet
DB_USERNAME=u000000000_enet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail.
# environetinc.com mail is on Microsoft 365 (MX environetinc-com.mail.protection.outlook.com), so send
# through a licensed M365 mailbox with SMTP AUTH enabled, or add Hostinger to the SPF record first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@environetinc.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@environetinc.com
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Set false at launch.
ENET_PREVIEW=false
ENET_PUBLIC_EMAIL=enetmail@environetinc.com
# Who is emailed about new submissions, comma separated. Each area falls back to ENET_NOTIFY_EMAIL.
ENET_NOTIFY_EMAIL=
ENET_NOTIFY_SOLICITATIONS=
ENET_NOTIFY_TEAMING=
ENET_NOTIFY_CAREERS=
ENET_NOTIFY_ENQUIRIES=
ENET_NOTIFY_ROOMS=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
